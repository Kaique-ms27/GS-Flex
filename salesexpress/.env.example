# Copie para ".env" na VM (cp .env.example .env) e preencha.
# NUNCA envie o .env para o GitHub.

# Domínio que aponta para o IP da VM (ex.: 129-148-10-20.sslip.io ou meuapp.duckdns.org)
DOMAIN=

# Supabase -> Connect -> Session pooler (porta 5432)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=

# Administrador inicial (só vale no primeiro start; depois troque pela aba Conta)
ADMIN_USUARIO=admin
ADMIN_SENHA=
